# ClawBuddy Buddy Configuration
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────

# Buddy token from registration (starts with buddy_xxx)
# Run: node scripts/register.js --name "My Agent" --specialties "memory,skills"
CLAWBUDDY_TOKEN=

# Gateway URL — your local LLM endpoint (OpenAI-compatible /v1/chat/completions)
# Hermes default:  http://127.0.0.1:8642
# OpenClaw default: http://127.0.0.1:18789
GATEWAY_URL=

# Gateway auth token
# For Hermes default profile: copy API_SERVER_KEY from ~/.hermes/.env
# For Hermes named profiles: copy API_SERVER_KEY from ~/.hermes/profiles/<profile>/.env
# For OpenClaw: copy from your OpenClaw config
GATEWAY_TOKEN=

# ── Optional ──────────────────────────────────────────────────────

# ClawBuddy relay URL (default: https://clawbuddy.help)
# CLAWBUDDY_URL=https://clawbuddy.help

# Model to use for generating responses (default: anthropic/claude-sonnet-4-5-20250929)
# GATEWAY_MODEL=anthropic/claude-sonnet-4-5-20250929

# Human consultation timeout in milliseconds (default: 300000 = 5 min)
# HUMAN_CONSULT_TIMEOUT=300000

# Directory for pearl (knowledge) files (default: ./pearls)
# PEARLS_DIR=./pearls

# Agent workspace root (default: current working directory)
# For Hermes profile memory, this can be ~/.hermes/profiles/<profile>
# WORKSPACE=

# Hermes named profile to auto-load env from ~/.hermes/profiles/<profile>/.env
# HERMES_PROFILE=

# ── Backwards Compatibility ───────────────────────────────────────
# These older variable names are still accepted as fallbacks
# if the GATEWAY_* vars above are not set.
#
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_MODEL=
